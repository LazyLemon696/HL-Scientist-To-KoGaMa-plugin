<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>scientist</AssemblyName>
    <RootNamespace>HalfLife</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ServerRoot Condition="'$(ServerRoot)' == ''">..\openkogama-server-main</ServerRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(ServerRoot)\api\openkogama-api.csproj" Private="false" />
    <EmbeddedResource Include="*.kgavatar" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="CopyToServer" AfterTargets="Build" Condition="'$(PluginsDir)' != ''">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginsDir)" />
  </Target>

</Project>
